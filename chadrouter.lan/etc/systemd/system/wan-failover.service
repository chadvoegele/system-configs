[Unit]
Description=WAN health monitoring and failover
Wants=network-online.target
After=network-online.target nftables.service wg-quick@wg0.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/python /usr/local/sbin/wan_failover.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
